# ==============================================================================
# WEDDING APP ENVIRONMENT VARIABLES CONFIGURATION (SUPABASE + VERCEL CLOUD)
# ==============================================================================

# Supabase Project URL
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Khuyến nghị cho Backend API vì bảo mật và bypass RLS an toàn)
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Anon Key (Public Key)
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Ghi chú:
# - Khi không cấu hình biến môi trường Supabase: Hệ thống tự động fallback đọc/ghi vào data/*.json (phục vụ local development).
# - Khi triển khai trên Vercel: Cấu hình các biến trên trong tab Vercel Dashboard -> Project Settings -> Environment Variables.
